<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0"><class>MainWindow</class><widget class="QMainWindow" name="MainWindow"><property name="minimumSize"><size><width>800</width><height>520</height></size></property><property name="windowTitle"><string>Bài 130 - Phần mềm tính khấu hao tài sản cố định</string></property><property name="styleSheet"><string>QWidget { font-family: "Segoe UI", "Roboto", "Noto Sans", sans-serif; }
QMainWindow, QWidget#centralwidget { background-color: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #eaf2ff, stop:1 #f8fbff); }
QWidget#widget_right { background: transparent; }
QLabel { font-size: 10pt; color: #1f3358; background: transparent; }
QLabel#label_title { font-size: 20pt; font-weight: bold; color: #17356e; }
QLabel#label_subtitle { font-size: 12pt; color: #4a7bc8; }
QLabel#label_slogan, QLabel#label_footer_quote { font-style: italic; font-size: 11pt; color: #2f5aa8; }
QFrame#frame_input, QFrame#frame_info { background: white; border: 1px solid #dbe6f5; border-radius: 14px; }
QFrame#frame_result { background: #effaf4; border: 1px solid #c9ead8; border-radius: 12px; }
QFrame#frame_result_rows { background: white; border: 1px solid #d9efe3; border-radius: 10px; }
QFrame#frame_result_rows QFrame#line_res_original, QFrame#frame_result_rows QFrame#line_res_annual { border: none; border-top: 1px solid #dcefe5; max-height: 1px; background: transparent; }
QFrame#frame_tip, QFrame#frame_note { background: #e6f6ee; border: 1px solid #cdebdb; border-radius: 8px; }
QFrame#frame_footer { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #eef5ff, stop:1 #e2eefc); border: none; border-radius: 12px; }
QFrame#frame_stat_original { background: #eaf3fd; border: 1px solid #cfe2f7; border-radius: 10px; }
QFrame#frame_stat_annual { background: #e9f7f0; border: 1px solid #cdebdb; border-radius: 10px; }
QFrame#frame_stat_monthly { background: #fff3e8; border: 1px solid #fadcc0; border-radius: 10px; }
QFrame#frame_stat_years { background: #eeefff; border: 1px solid #d8d9f7; border-radius: 10px; }
QLabel#label_step1 { background: #1d5fd8; color: white; border-radius: 18px; font-size: 14pt; font-weight: bold; }
QLabel#label_input_title, QLabel#label_info_title, QLabel#label_table_title { font-size: 13pt; font-weight: bold; color: #17356e; }
QLabel#label_result_title { font-size: 13pt; font-weight: bold; color: #1b8a5a; }
QLabel#label_tip, QLabel#label_note { font-size: 9.5pt; color: #1f3358; }
QLabel#label_val_original, QLabel#label_val_annual, QLabel#label_val_monthly { font-size: 13pt; font-weight: bold; color: #17806a; }
QLabel#label_stat_original, QLabel#label_stat_years { font-size: 12pt; font-weight: bold; color: #1d5fd8; }
QLabel#label_stat_annual { font-size: 12pt; font-weight: bold; color: #1b8a5a; }
QLabel#label_stat_monthly { font-size: 12pt; font-weight: bold; color: #e8782a; }
QLabel#label_stat_years { color: #5a4bc4; }
QLabel#label_stat_caption_original, QLabel#label_stat_caption_annual, QLabel#label_stat_caption_monthly, QLabel#label_stat_caption_years { font-size: 8.5pt; }
QLineEdit, QSpinBox { border: 1px solid #cdd9ea; border-radius: 6px; padding: 8px 10px; background: white; font-size: 11pt; color: #1f3358; min-height: 20px; }
QLineEdit:focus, QSpinBox:focus { border: 1px solid #2f8cf0; }
QSpinBox::up-button, QSpinBox::down-button { width: 18px; border: none; background: transparent; }
QPushButton { border: none; border-radius: 8px; padding: 10px 16px; font-size: 11pt; font-weight: bold; color: white; }
QPushButton#pushButton_calculate { background: #2f8cf0; min-height: 26px; }
QPushButton#pushButton_calculate:hover { background: #1f7ae0; }
QPushButton#pushButton_detail { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #7d86e8, stop:1 #8a82e0); font-size: 12pt; min-height: 34px; border-radius: 10px; }
QPushButton#pushButton_detail:hover { background: #6f78dd; }
QPushButton#pushButton_clear, QPushButton#pushButton_exit { background: white; border: 1px solid #cdd9ea; color: #3b4a66; padding: 6px 14px; font-weight: normal; }
QPushButton#pushButton_clear:hover { background: #fff6e6; border-color: #f59e0b; }
QPushButton#pushButton_exit:hover { background: #fdecec; border-color: #dc2626; }
QTableWidget { background: white; alternate-background-color: #f1f6fd; border: 1px solid #dbe6f5; border-radius: 8px; gridline-color: #e3ebf7; font-size: 10.5pt; color: #1f3358; }
QHeaderView::section { background-color: #2c5aa0; color: white; padding: 8px; border: none; border-right: 1px solid #4a74b8; font-weight: bold; font-size: 9pt; }
QScrollArea, QWidget#scrollAreaWidgetContents { background: transparent; border: none; }
QScrollArea &gt; QWidget &gt; QWidget { background: transparent; }
QFrame#frame_empty { background: #f6f9ff; border: 1px dashed #bcd0ee; border-radius: 10px; }
QLabel#label_empty { color: #6b83ab; font-size: 11pt; font-style: italic; }
QLineEdit { placeholder-text-color: #a9b6cc; }
