  <property name="windowTitle"><string>Khấu hao tài sản cố định - Phương pháp đường thẳng</string></property>
  <property name="styleSheet"><string notr="true">QMainWindow, QWidget#centralwidget { background-color: #f4f6fb; }
QLabel { font-size: 10pt; color: #2d3748; }
QLabel#label_title { font-size: 17pt; font-weight: bold; color: #1e3a8a; }
QLabel#label_subtitle { color: #64748b; }
QLabel#label_summary { color: #1e3a8a; font-weight: bold; }
QGroupBox { font-weight: bold; font-size: 10pt; color: #1e3a8a; background: white; border: 1px solid #d5dbe8; border-radius: 8px; margin-top: 12px; padding: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; }
QLineEdit, QSpinBox { border: 1px solid #cbd5e1; border-radius: 5px; padding: 5px; background: white; font-size: 10pt; }
QLineEdit:focus, QSpinBox:focus { border: 1px solid #2563eb; }
QLineEdit:read-only { background: #eef2ff; color: #1e3a8a; font-weight: bold; }
QPushButton { background-color: #2563eb; color: white; border: none; border-radius: 6px; padding: 8px 16px; font-size: 10pt; font-weight: bold; }
QPushButton:hover { background-color: #1d4ed8; }
QPushButton#pushButton_detail { background-color: #059669; }
QPushButton#pushButton_detail:hover { background-color: #047857; }
QPushButton#pushButton_clear { background-color: #f59e0b; }
QPushButton#pushButton_clear:hover { background-color: #d97706; }
QPushButton#pushButton_exit { background-color: #dc2626; }
QPushButton#pushButton_exit:hover { background-color: #b91c1c; }
QTableWidget { background: white; alternate-background-color: #f1f5f9; border: 1px solid #d5dbe8; gridline-color: #e2e8f0; font-size: 10pt; }
QHeaderView::section { background-color: #1e3a8a; color: white; padding: 6px; border: none; font-weight: bold; }</string></property>
  <widget class="QWidget" name="centralwidget">
